# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 의해 커밋되지 않는다.

# TMDB API (v3 key) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# JWT 서명 시크릿 (생성 예: openssl rand -base64 48)
JWT_SECRET=

# 로컬 DB 자격증명 — docker-compose.yml 기본값과 일치시킨다
POSTGRES_USER=scenelog
POSTGRES_PASSWORD=scenelog
POSTGRES_DB=scenelog
MONGO_DB=scenelog
